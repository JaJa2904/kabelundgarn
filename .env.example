# S3-compatible object storage (contact form file attachments)
# Used by /api/upload-url and contact form. Leave empty to disable uploads.
# Examples: Cloudflare R2, Hetzner Object Storage, MinIO, AWS S3

S3_ENDPOINT=
# e.g. https://<accountid>.r2.cloudflarestorage.com
# or https://fsn1.your-objectstorage.com (Hetzner)
# or http://localhost:9000 (MinIO)

S3_REGION=auto
# "auto" for R2; use region code (e.g. eu-central-1) for AWS

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Optional: set to public base URL for uploaded files (e.g. CDN or bucket public URL).
# Contact submissions will include this URL + object key when set.
PUBLIC_FILE_BASE_URL=

# Optional: set to "true" for MinIO / path-style endpoints
# S3_FORCE_PATH_STYLE=false
